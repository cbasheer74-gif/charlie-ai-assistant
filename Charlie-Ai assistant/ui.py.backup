        self._sub_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        _sf = QFont("Plus Jakarta Sans", 8, QFont.Weight.Bold)
        _sf.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 1.8)
        self._sub_lbl.setFont(_sf)
        self._sub_lbl.setStyleSheet("color: #38bdf8; background: transparent;")
        sub_row.addWidget(self._sub_lbl)

        sep = QLabel("•")
        sep.setStyleSheet("color: #334155; font-size: 10px; background: transparent;")
        sub_row.addWidget(sep)

