        w.setObjectName("AppHeader")
        w.setFixedHeight(78)
        w.setStyleSheet("""
            QWidget#AppHeader {
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0d131f, stop:1 #070a12);
                border-bottom: 1px solid rgba(56, 189, 248, 0.14);
            }
        """)
        lay = QHBoxLayout(w)
        lay.setContentsMargins(20, 0, 20, 0)
        lay.setSpacing(10)

        # ── Left: Brand Mark & Controls ──
        brand_mark = QLabel()
        brand_mark.setFixedSize(32, 32)
        brand_mark.setAlignment(Qt.AlignmentFlag.AlignCenter)
        _icon_png = Path(__file__).resolve().parent / "config" / "charlie.png"
        if _icon_png.exists():
            _px = QPixmap(str(_icon_png)).scaled(26, 26, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            brand_mark.setPixmap(_px)
            brand_mark.setStyleSheet(
                "background: rgba(12, 18, 32, 0.95); "
                "border: 1px solid rgba(56, 189, 248, 0.45); border-radius: 9px;"
            )
        else:
            brand_mark.setText("C")
            brand_mark.setFont(QFont("Plus Jakarta Sans", 14, QFont.Weight.Black))
            brand_mark.setStyleSheet(
                "color: #00F5FF; background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d1b2e, stop:1 #060912); "
                "border: 1px solid rgba(56, 189, 248, 0.5); border-radius: 9px;"
            )
        lay.addWidget(brand_mark)

        ver_badge = QLabel(APP_VERSION)
        ver_badge.setFont(QFont("Plus Jakarta Sans", 8, QFont.Weight.Bold))
        ver_badge.setStyleSheet(
            "color: #94a3b8; background: rgba(255, 255, 255, 0.05); "
            "border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 6px; padding: 2px 7px;"
