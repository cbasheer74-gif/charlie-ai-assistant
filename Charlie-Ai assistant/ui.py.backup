        self._drawer_btn.setIcon(QIcon(_render_hub_svg("gear", 18, "#94a3b8")))
        self._drawer_btn.setIconSize(QSize(18, 18))
        self._drawer_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._drawer_btn.setToolTip("Settings & Controls")
        self._drawer_btn.setStyleSheet("""
            QPushButton {
                background: #0f172a; color: #94a3b8;
                border: 1px solid #1e293b; border-radius: 9px;
            }
            QPushButton:hover {
                background: #1e293b; color: #38bdf8;
                border-color: rgba(56, 189, 248, 0.4);
            }
            QPushButton:checked {
                color: #38bdf8; border-color: #38bdf8; background: rgba(56, 189, 248, 0.15);
            }
        """)
        self._drawer_btn.setCheckable(True)
        self._drawer_btn.clicked.connect(self._toggle_drawer)
        lay.addWidget(self._drawer_btn)

        self._hub_btn = QPushButton("Intelligence Hub")
        self._hub_btn.setFixedHeight(36)
        self._hub_btn.setIcon(QIcon(_render_hub_svg("hub_logo", 16, "#38bdf8")))
        self._hub_btn.setIconSize(QSize(16, 16))
        self._hub_btn.setFont(QFont("Plus Jakarta Sans", 9, QFont.Weight.DemiBold))
        self._hub_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._hub_btn.setToolTip("Open CHARLIE advanced features")
        self._hub_btn.setStyleSheet("""
            QPushButton {
                background: #0f172a; color: #cbd5e1;
                border: 1px solid #1e293b; border-radius: 9px;
                padding: 0 13px;
            }
            QPushButton:hover {
                background: #1e293b;
                border-color: #38bdf8; color: #ffffff;
            }
        """)
        self._hub_btn.clicked.connect(self._open_intelligence_hub)
        lay.addWidget(self._hub_btn)
        lay.addStretch()

        # ── Center: Hero Brand Identity ──
        mid = QVBoxLayout()
        mid.setSpacing(3)
        mid.setAlignment(Qt.AlignmentFlag.AlignCenter)
        _disp = self._assistant_name.upper()

        self._title_lbl = QLabel(f"◈  {_disp}  ◈")
        self._title_lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        _tf = QFont("Plus Jakarta Sans", 18, QFont.Weight.ExtraBold)
        _tf.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 3.5)
        self._title_lbl.setFont(_tf)
        self._title_lbl.setStyleSheet("color: #ffffff; background: transparent; padding: 0px;")
        mid.addWidget(self._title_lbl)

        sub_row = QHBoxLayout()
        sub_row.setSpacing(8)
        sub_row.setAlignment(Qt.AlignmentFlag.AlignCenter)

        _sub_text = "AUTONOMOUS AI ASSISTANT"
