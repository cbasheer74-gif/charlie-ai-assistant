        self._plan_header_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._plan_header_btn.setToolTip("View your subscription, usage and available plans")
        self._plan_header_btn.setStyleSheet("""
            QPushButton {
                background: rgba(16, 185, 129, 0.12); color: #34d399;
